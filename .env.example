# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=          # server only: cron, seeding, eval writes

# LLM (default: Google Gemini free tier; Claude is a drop-in for paid client builds)
LLM_PROVIDER=gemini                 # gemini | anthropic
LLM_MODE=live                       # live | replay (recorded responses for the demo contracts)
LLM_MODEL=gemini-2.5-flash          # verify against the models your key can list
LLM_JUDGE_MODEL=gemini-2.5-flash
GEMINI_API_KEY=                     # from aistudio.google.com
ANTHROPIC_API_KEY=                  # optional, only when LLM_PROVIDER=anthropic

# Embeddings
EMBEDDING_PROVIDER=gemini           # gemini | voyage
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMS=768                  # must match the vector(N) column in the migration
VOYAGE_API_KEY=                     # optional, only when EMBEDDING_PROVIDER=voyage

# Ops / demo limits
CRON_SECRET=                        # Vercel Cron bearer
DEMO_MODE=true
DEMO_DAILY_REVIEW_LIMIT=5           # per sandbox
DEMO_DAILY_QA_LIMIT=40
MAX_UPLOAD_MB=10
MAX_PAGES=60
NEXT_PUBLIC_SITE_URL=http://localhost:3000
